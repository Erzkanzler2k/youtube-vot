<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vot.youtube"
    android:versionCode="37"
    android:versionName="2.6.3">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.YouTubeVot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="youtube.com"
                    android:scheme="https" />
                <data
                    android:host="www.youtube.com"
                    android:scheme="https" />
                <data
                    android:host="m.youtube.com"
                    android:scheme="https" />
                <data
                    android:host="music.youtube.com"
                    android:scheme="https" />
                <data
                    android:host="youtu.be"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    <service
            android:name=".BypassVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_dpi_bypass" />
        </service>

        <!-- РўРѕС‡РєР° РёР·РјРµСЂРµРЅРёСЏ РѕР±С…РѕРґР°. isolatedProcess РѕР±СЏР·Р°С‚РµР»РµРЅ: РїСЂРѕС†РµСЃСЃ
             РїСЂРёР»РѕР¶РµРЅРёСЏ РёСЃРєР»СЋС‡С‘РЅ РёР· С‚СѓРЅРЅРµР»СЏ (addDisallowedApplication), РїРѕСЌС‚РѕРјСѓ
             РµРіРѕ СЃРѕРєРµС‚С‹ РёРґСѓС‚ РјРёРјРѕ РґРµСЃРєР°РЅРєР° Рё РІСЃРµРіРґР° РїРѕРєР°Р·С‹РІР°СЋС‚ В«СЂР°Р±РѕС‚Р°РµС‚В».
             РР·РѕР»РёСЂРѕРІР°РЅРЅС‹Р№ СЃРµСЂРІРёСЃ РїРѕР»СѓС‡Р°РµС‚ СЃРѕР±СЃС‚РІРµРЅРЅС‹Р№ UID, РІ disallowlist РЅРµ
             Р·РЅР°С‡РёС‚СЃСЏ Рё РїРѕС‚РѕРјСѓ РёР·РјРµСЂСЏРµС‚ СЂРµР°Р»СЊРЅС‹Р№ РїСѓС‚СЊ С‚СЂР°С„РёРєР°. -->
        <service
            android:name=".BypassProbeService"
            android:exported="false"
            android:isolatedProcess="true" />

        <!-- Р—Р°РІРµСЂС€РµРЅРёРµ Р·Р°РіСЂСѓР·РєРё APK: РЅР° API 26+ implicit-Р±СЂРѕР°РґРєР°СЃС‚
             DOWNLOAD_COMPLETE РґРѕСЃС‚Р°РІР»СЏРµС‚СЃСЏ С‚РѕР»СЊРєРѕ РјР°РЅРёС„РµСЃС‚РЅС‹Рј receiver'РѕРј.
             exported=true РѕР±СЏР·Р°С‚РµР»РµРЅ: Р±СЂРѕР°РґРєР°СЃС‚ С€Р»С‘С‚ DownloadManager (СЃС‚РѕСЂРѕРЅРЅРёР№
             UID), Р° РЅРµ РЅР°С€Рµ РїСЂРёР»РѕР¶РµРЅРёРµ. Р‘РµР·РѕРїР°СЃРЅРѕСЃС‚СЊ РѕР±РµСЃРїРµС‡РёРІР°РµС‚ СЃРІРµСЂРєР° id
             Р·Р°РіСЂСѓР·РєРё СЃ РЅР°С€РёРјРё prefs РІ UpdateDownloadReceiver. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
