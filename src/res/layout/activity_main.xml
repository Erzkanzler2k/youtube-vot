<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Верхняя панель: только бренд (управление — внизу, под палец) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_brand_logo"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_youtube"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand_vot"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Тонкий прогресс-бар загрузки -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/progress_bg"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background" />

    <!-- Разделитель над нижней навигацией -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Нижняя панель: вкладки + управление -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/tab_home"
                android:paddingTop="4dp">

                <View
                    android:id="@+id/tab_home_ind"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:background="@drawable/tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tab_home_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:src="@drawable/ic_tab_home"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_home_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_home"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_shorts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/tab_shorts"
                android:paddingTop="4dp">

                <View
                    android:id="@+id/tab_shorts_ind"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:background="@drawable/tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tab_shorts_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:src="@drawable/ic_tab_shorts"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_shorts_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_shorts"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_trending"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/tab_trending"
                android:paddingTop="4dp">

                <View
                    android:id="@+id/tab_trending_ind"
                    android:layout_width="34dp"
                    android:layout_height="3dp"
                    android:background="@drawable/tab_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/tab_trending_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="3dp"
                    android:src="@drawable/ic_tab_trending"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tab_trending_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_trending"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <!-- Разделитель между вкладками и управлением -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Управление: назад / вперёд / обновить / выход (в зоне большого пальца) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/icon"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:alpha="0.35"
                android:contentDescription="@string/nav_back" />

            <ImageView
                android:id="@+id/btn_forward"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:padding="11dp"
                android:src="@drawable/ic_forward"
                android:tint="@color/icon"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:alpha="0.35"
                android:contentDescription="@string/nav_forward" />

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:padding="11dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/icon"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/refresh" />

            <ImageView
                android:id="@+id/btn_exit"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:tint="@color/icon"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/exit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Контейнер для полноэкранного видео -->
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Фирменный загрузочный экран (показывается при холодном старте) -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_brand_logo"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_youtube"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_vot"
                    android:textColor="@color/accent"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/title_sub"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Выбор страны рекомендуемого контента -->
            <LinearLayout
                android:id="@+id/splash_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:contentDescription="@string/region_row_desc">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_globe"
                    android:tint="@color/text_secondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/splash_region_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:text="" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Офлайн: нет соединения -->
    <FrameLayout
        android:id="@+id/offline_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_brand_logo"
                android:alpha="0.55"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/offline_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/offline_sub"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/btn_retry_bg"
                android:paddingStart="34dp"
                android:paddingEnd="34dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/retry"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>