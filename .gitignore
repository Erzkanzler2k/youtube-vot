# Сборка/артефакты
build/
out/
*.idsig

# Ключ подписи намеренно в репозитории:
# чтобы любая пересборка (на любой машине) давала ту же подпись и
# новые версии устанавливались поверх старых без сноса приложения.
# Never commit signing keys or credentials
*.jks
*.keystore
release-signing.env

# Прочее
*.log
.DS_Store
Thumbs.db
# Сборочные артефакты NDK (попадают в APK через ZipFix, в git не нужны)
src/cpp/libs/
src/cpp/obj/
